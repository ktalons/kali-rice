#!/usr/bin/env bash
#
# htb-target — set the box you are currently pointed at.
#
#   htb-target 10.10.11.35              set the target
#   htb-target 10.10.11.35 cicada.htb   set it and add a /etc/hosts entry
#   htb-target                          print the current target
#   htb-target --clear                  unset it and drop the hosts entry
#
# The value lands in $TARGET in every shell (next prompt) and in the polybar
# module immediately.
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/htb-lib.sh"

usage() { sed -n '3,11p' "$0" | sed 's/^# \?//'; exit "${1:-0}"; }

hosts_clear() {
  # Only ever touches lines this tool added.
  sudo sed -i "\|${HTB_HOSTS_MARK}\$|d" /etc/hosts
}

hosts_add() {
  local ip="$1" name="$2"
  hosts_clear
  printf '%s\t%s\t%s\n' "$ip" "$name" "$HTB_HOSTS_MARK" | sudo tee -a /etc/hosts >/dev/null
  hok "/etc/hosts: $ip -> $name"
}

cmd_show() {
  local target box
  target=$(state_get target)
  if [ -z "$target" ]; then
    printf '  %sno target set%s\n' "$C_DIM" "$C_RESET"
    return 1
  fi
  hok "target  $target"
  box=$(state_get box)
  [ -n "$box" ] && printf '  %sbox     %s%s\n' "$C_DIM" "$box" "$C_RESET"
  local hostent
  hostent=$(grep -F "$HTB_HOSTS_MARK" /etc/hosts 2>/dev/null | awk '{print $2}' || true)
  [ -n "$hostent" ] && printf '  %shosts   %s%s\n' "$C_DIM" "$hostent" "$C_RESET"
  return 0
}

case "${1:-}" in
  "")            cmd_show ;;
  -h|--help)     usage ;;
  --clear|clear)
    state_clear target
    hosts_clear
    hok "target cleared"
    ;;
  -*)            usage 1 ;;
  *)
    target="$1"
    valid_target "$target" || hdie "refusing '$target' — letters, digits, dot, dash, underscore only"
    state_set target "$target"
    hok "target  $target"

    if [ -n "${2:-}" ]; then
      valid_target "$2" || hdie "refusing hostname '$2'"
      hosts_add "$target" "$2"
    fi

    # Record it alongside the box so the engagement dir is self-describing
    # after the fact.
    box=$(state_get box)
    if [ -n "$box" ] && [ -d "$HTB_ROOT/boxes/$box" ]; then
      printf '%s\n' "$target" > "$HTB_ROOT/boxes/$box/.target"
    fi
    ;;
esac
